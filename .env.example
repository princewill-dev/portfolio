# Copy this file to .env and fill in real values.
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Required for HTTPS deployments (must include the scheme).
CSRF_TRUSTED_ORIGINS=https://princewill.cc,https://www.princewill.cc

# Leave DATABASE_URL empty to use local SQLite (db.sqlite3).
# Set it to use Postgres, e.g.:
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=
